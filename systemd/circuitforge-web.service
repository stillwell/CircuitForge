[Unit]
Description=CircuitForge web portal
Documentation=https://github.com/stillwell/circuitforge
After=network-online.target circuitforge-api.service
Wants=network-online.target

[Service]
Type=simple
User=circuitforge
Group=circuitforge
WorkingDirectory=/opt/circuitforge
EnvironmentFile=-/etc/circuitforge/web.env
ExecStart=/opt/circuitforge/.venv/bin/python /opt/circuitforge/run_web.py --prod
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/opt/circuitforge/data
UMask=0027

[Install]
WantedBy=multi-user.target
